def surfaceArea(A):
    H = len(A)
    W = len(A[0])

    area = 0

    for i in range(H):
        for j in range(W):
            if A[i][j] > 0:
                area += 2  # top and bottom

                up = A[i - 1][j] if i > 0 else 0
                down = A[i + 1][j] if i < H - 1 else 0
                left = A[i][j - 1] if j > 0 else 0
                right = A[i][j + 1] if j < W - 1 else 0

                area += max(A[i][j] - up, 0)
                area += max(A[i][j] - down, 0)
                area += max(A[i][j] - left, 0)
                area += max(A[i][j] - right, 0)

    return area


H, W = map(int, input().split())
A = [list(map(int, input().split())) for _ in range(H)]

print(surfaceArea(A))
